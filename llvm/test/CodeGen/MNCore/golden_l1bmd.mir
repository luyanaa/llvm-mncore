# RUN: llc -mtriple=mncore2 %s -o - | FileCheck %s
#
# Numeric distributed-load test (SDM 3.6.8.20): two l1bmd transfers load
# the low and high longword planes into one 2-longword PE slot. Verified
# on gpfn3: GREG0 index 0 = 0xAA (low plane), index 2 = 0xBB (high plane).
#
# d set/get spec: [3:0]mem (1=GRF0 6=L1B), [20:4]addr, [28:21]nwords
#   L1B@<a> n1 = 6 | (a << 4) | (1 << 21)
#   GRF0@0 n4 = 1 | (4 << 21) = 8388609

--- |
  target triple = "mncore2"
  define void @l1bmd_dist() { ret void }
...
---
name:            l1bmd_dist
body:             |
  bb.0:
    DSET 2097158, 170
